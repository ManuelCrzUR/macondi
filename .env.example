# Copia este archivo como .env.local para probar con `vercel dev`.
# En producción, configúralas en Vercel → Project → Settings → Environment Variables.

OPENAI_API_KEY=sk-...
# Modelo de chat (opcional). Por defecto: gpt-4o-mini
OPENAI_MODEL=gpt-4o-mini
# Límite de mensajes por IP (opcional): 25 mensajes cada 10 minutos
RATE_LIMIT_MAX=25
RATE_LIMIT_WINDOW_MIN=10
# Dominios que pueden usar /api/chat, separados por coma (opcional, recomendado)
# ALLOWED_ORIGINS=https://macondi.vercel.app,https://www.macondi.co
# Voz de OpenAI (opcional): modelo y voz (alloy, ash, ballad, coral, echo, fable, nova, onyx, sage, shimmer)
# OPENAI_TTS_MODEL=gpt-4o-mini-tts
# OPENAI_TTS_VOICE=coral
